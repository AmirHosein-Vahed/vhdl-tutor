{
  "name": "vhdl-tutor",
  "build": {
    "dockerfile": "../tools/Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/course",
  "customizations": {
    "vscode": {
      "extensions": [
        "teros-technology.teroshdl"
      ],
      "settings": {
        "teroshdl.general.useVhdlLinter": false
      }
    }
  },
  "postCreateCommand": "make env && make check-lessons && make test-all"
}
